# Copy this file to .env.local and fill in real values.
# .env.local is gitignored (see *.local) — never commit real keys.
#
# These are read by the Vercel serverless functions in /api. Set the same
# values in the Vercel dashboard: Settings > Environment Variables.

# From resend.com/api-keys (starts with "re_")
RESEND_API_KEY=re_replace_with_your_key

# Inbox that receives booking alerts and CV submissions
NOTIFY_EMAIL=kabiru@careerdatasolutions.com

# Sender address on a domain verified in Resend. Once careerdatasolutions.com
# is verified (Resend > Domains), any address on it can send.
NOTIFY_FROM=kabiru@careerdatasolutions.com

# ── Rate-limit store ─────────────────────────────────────────
# NOT optional in production, despite being commented out here.
#
# api/_lib/rate-limit.js caps the public routes per IP: /api/order and the
# three that send mail at five per ten minutes, /api/promo at twenty,
# /api/order-status at 240. Serverless instances share no memory, so without
# a store outside the function those counters are per-instance and reset on
# every cold start — the deploy looks rate-limited and is not. It logs
# "[rate-limit] No KV_REST_API_* or UPSTASH_REDIS_REST_* configured" once per
# instance when that happens; grep the Vercel logs for it to confirm.
#
# Either pair works — the code speaks the Upstash REST protocol, which Vercel
# KV also speaks. Set ONE of them, not both:
#
#   Vercel KV     Storage > Create > KV, then Connect Project. Vercel injects
#                 KV_REST_API_URL and KV_REST_API_TOKEN itself; nothing to
#                 paste, and nothing to add here.
#   Upstash       console.upstash.com > Create Database, then copy the REST
#                 URL and token into the Vercel dashboard by hand.
#
# Local dev does not need either: one machine, one process, so the in-memory
# fallback counts correctly. This matters on the deploy.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Career checkout (/career/order) ──────────────────────────
# Both optional. Checkout works with neither set.

# Payment rail for the M-Pesa STK push. "stub" (default) simulates a successful
# payment after a few seconds so the flow can be tested without credentials and
# without real money. "daraja" talks to Safaricom directly.
# PAYMENT_PROVIDER=daraja

# ── Safaricom Daraja ─────────────────────────────────────────
# Only needed when PAYMENT_PROVIDER=daraja.
#
# No values are listed here on purpose: this file is committed, so it carries
# variable NAMES only. Real values live in .env.local (gitignored) and in the
# Vercel dashboard.
#
# SANDBOX: key and secret come from your own app at developer.safaricom.co.ke
# (Add App > Lipa Na M-Pesa Sandbox). The shortcode and passkey are Safaricom's
# public sandbox values, published in their docs. Test with phone
# 254708374149. The prompt appears and the callback fires, but no money moves.
#
# PRODUCTION: set MPESA_ENV=production and swap in your own shortcode, passkey,
# key and secret from the Go Live process. Nothing else changes.

# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=

# Set to 1 only if your shortcode is a Buy Goods till rather than a Paybill —
# Safaricom rejects the wrong transaction type.
# MPESA_TILL=0

# Absolute https URL Safaricom POSTs to, including the ?k= secret below.
# Must be publicly reachable with a valid certificate: Safaricom cannot call
# localhost, so use a deploy preview or an ngrok tunnel while developing.
# MPESA_CALLBACK_URL=https://careerdatasolutions.com/api/pay-callback?k=REPLACE_ME

# Daraja does not sign its callbacks, so this shared secret in the URL is what
# authenticates them. Any long random string; must match the ?k= value above.
# MPESA_CALLBACK_SECRET=REPLACE_ME

# Signs the order token the browser holds between the STK push and the
# confirmation (see api/_lib/orders.js). Any long random string. If unset, a key
# is derived from RESEND_API_KEY so a fresh clone still works — set it properly
# in production.
# ORDER_SECRET=

# Signing secret from your payment provider, for verifying /api/pay-callback.
# Only needed once a real PAYMENT_PROVIDER is wired up.
# PAY_WEBHOOK_SECRET=
