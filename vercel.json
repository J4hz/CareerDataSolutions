{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/services",        "destination": "/",                "permanent": true },
    { "source": "/data-services",   "destination": "/data/services",   "permanent": true },
    { "source": "/career-services", "destination": "/career/services", "permanent": true },
    { "source": "/packages",        "destination": "/",                "permanent": true },
    { "source": "/about",           "destination": "/data/about",      "permanent": true },
    { "source": "/contact",         "destination": "/data/contact",    "permanent": true },
    { "source": "/contact/data",    "destination": "/data/contact",    "permanent": true },
    { "source": "/contact/career",  "destination": "/career/contact",  "permanent": true },
    { "source": "/data",            "destination": "/data/services",   "permanent": false },
    { "source": "/career",          "destination": "/career/services", "permanent": false }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    }
  ]
}
